{
  "name": "xdj-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Capability-aware XDJ acquisition, visualizer and OSC bridge",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "node dist/src/main.js",
    "demo": "node dist/src/main.js --mode demo",
    "replay": "node dist/src/main.js --mode replay",
    "package": "npm run build && node scripts/package.mjs",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ws": "8.21.3"
  },
  "optionalDependencies": {
    "alphatheta-connect": "0.28.5"
  },
  "overrides": {
    "alphatheta-connect": {
      "metadata-connect": "1.2.2",
      "onelibrary-connect": "1.1.6"
    }
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/ws": "8.18.1",
    "linkedom": "0.18.12",
    "typescript": "5.9.3"
  }
}
